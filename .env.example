DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoicely
APP_URL=http://localhost:3000
# 32 random bytes (hex or base64). Required in production: openssl rand -hex 32
ENCRYPTION_KEY=
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads
# S3-compatible storage (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Email (Resend). Without it, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Invoicely <no-reply@example.com>
# Optional path to Chrome/Chromium for PDF rendering
CHROMIUM_PATH=
